# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y
# IDF 6.0 default-libc ist Picolibc; in Kombination mit dem xtensa-esp-elf-gcc
# 15.2.0-Toolchain schlaegt ESP-IDFs eigenes hal/assert.h (__noreturn via [[noreturn]])
# mit "'noreturn' attribute does not apply to types" (-Werror=attributes) fehl -- ein
# Espressif-seitiges Kompatibilitaetsproblem, kein Bug in diesem Projekt. Newlib nimmt
# diesen Codepfad gar nicht erst (s. esp_libc/Kconfig-Hilfetext, der genau das als
# Workaround nennt).
CONFIG_LIBC_NEWLIB=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_LOG_COLORS=y
CONFIG_LWIP_HOOK_IP6_INPUT_NONE=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
# mbedTLS default (internal-only) buffer allocation exhausts internal DRAM once a
# second concurrent TLS connection is opened (e.g. dashboard page + websocket upgrade
# in parallel), even though PSRAM is available -- fails with PSA_ERROR_INSUFFICIENT_MEMORY
# (mbedtls_ssl_setup returns -0x008D) on the second connection. Let mbedTLS's allocator
# follow normal ESP-IDF malloc() behavior instead so it can spill into PSRAM.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y
