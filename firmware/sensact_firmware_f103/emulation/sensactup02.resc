:name: sensactUp rev 0.2
:description: Sensact-Station (SNSCT_L1_LVNG_UP / KTCH) auf dem STM32F103, Konsole USART1. $bin = ELF.

$name?="sensactup02"
$bin?=@build/lvng/sensact_f103.elf

using sysbus
include $ORIGIN/../../../../rtoos/emulation/renode/STM32H5_TIM.cs
include $ORIGIN/../../../../rtoos/emulation/renode/STM32F1_DMA.cs
include $ORIGIN/PCA9685.cs
include $ORIGIN/CanInjector.cs
mach create $name
machine LoadPlatformDescription $ORIGIN/sensactup02.repl
machine LoadPlatformDescriptionFromString "canInjector: CAN.CanInjector @ sysbus <0x50000000, +0x10>"
emulation CreateCANHub "canHub"
connector Connect sysbus.can1 canHub
connector Connect sysbus.canInjector canHub

# die Firmware liegt hinter dem CAN-Bootloader ab 0x08004000; ohne ihn (sensactup02_boot.resc) direkt starten
macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x08004000
"""
runMacro $reset
